# ============================================================
# Build dependencies & tooling
# ============================================================
# NOTE: no leading slash on purpose. Docker matches slash-less
# patterns as a basename at ANY depth, so this single line also
# drops .opencode/node_modules. Do NOT write /node_modules.
node_modules

# ============================================================
# Next.js build artifacts (rebuilt inside the image)
# ============================================================
.next
out
next-env.d.ts.timestamp

# ============================================================
# VCS, CI, agent context & docs
# ============================================================
.git
.github
.opencode
docs

# ============================================================
# Root-level docs & scratch files (junk, never in the image)
# ============================================================
*.md
*.bak
qwen-*.txt

# ============================================================
# Container/infra files (not inputs to the app build)
# ============================================================
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# ============================================================
# Secrets & OS cruft
# ============================================================
.env*
*.log
.DS_Store

# ============================================================
# TLS private keys — MUST NEVER enter an image layer
# ============================================================
# The certs are bind-mounted read-only at runtime. If they were also COPYed in,
# the private key would be recoverable from `docker history` and from every
# intermediate layer of the build cache, long after "docker rmi" -- which is
# exactly how private keys leak. `docker/nginx/*.conf` is NOT ignored: the
# runtime stage bakes those in as its default config.
docker/certs
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# ============================================================
# Intentionally NOT ignored:
#   docker/nginx/nginx.conf, docker/nginx/conf.d/, docker/nginx/snippets/
#   -> COPYed into the runtime stage as the image's default nginx config
# ============================================================

# ============================================================
# Intentionally NOT ignored (required to build):
#   app/ components/ lib/ hooks/ public/
#   package.json package-lock.json
#   next.config.ts tsconfig.json
#   postcss.config.mjs eslint.config.mjs
#   next-env.d.ts components.json
# ============================================================
