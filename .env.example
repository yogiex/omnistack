# =============================================================================
# OmniStack — Docker Compose environment
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored; `.env.example` is not.
#   cp .env.example .env
#
# Every value below is read by `docker-compose` itself, not by the container.
# Nothing here reaches the running nginx process -- changing a value requires a
# `docker-compose up -d` to take effect, and NEXT_PUBLIC_BASE_PATH additionally
# requires `--build` because Next.js inlines it at build time.
# =============================================================================

# -----------------------------------------------------------------------------
# Network binding
# -----------------------------------------------------------------------------
# 127.0.0.1 = reachable only from this machine. This is the default on purpose.
#
# The app has no server-side authentication: `components/route-guard.tsx` only
# hides UI in the browser, so anyone who can load the page can read the mock
# data and drive every "deploy". Publishing on 0.0.0.0 without putting real auth
# in front is the same as publishing an unauthenticated admin panel.
#
# Note that Docker's published ports bypass ufw/firewalld, because the DNAT
# happens before the host INPUT chain is evaluated -- a closed firewall will NOT
# save you if this is 0.0.0.0.
BIND_ADDR=127.0.0.1

# -----------------------------------------------------------------------------
# Host ports
# -----------------------------------------------------------------------------
# 58443 is the only published port: HTTPS only, no plain-HTTP port opened.
# The candidates were 54433 / 58443 / 60443 / 64443; 58443 keeps the 443
# mnemonic while staying well off the automated-scanner path.
#
# KNOWN TRADEOFF, so it is written down rather than discovered later: 58443 is
# INSIDE the default Linux ephemeral port range (32768-60999). An outbound
# browser or Node connection can be assigned it as a source port, after which
# the server cannot bind. Symptom: an intermittent, hard-to-reproduce "address
# already in use" on start. It is rare on a single-user machine, but if you hit
# it, move to a port above 60999 (e.g. 64433) before debugging anything else.
#
# ⚠️  The container port is hardcoded to the same value in
#     docker/nginx/conf.d/omnistack.conf, because the HTTP->HTTPS redirect
#     needs the external port and nginx's `$host` has it stripped. If you change
#     HTTPS_PORT here, change the `listen` directive there too, or the redirect
#     will point at a port nothing is listening on.
HTTPS_PORT=58443

# Optional. Leave unset (or commented) to publish HTTPS only. Set it to publish
# the plain-HTTP listener on 8080 as well, whose only job is to 301-redirect to
# HTTPS_PORT. Uncommenting adds a second open host port for that purpose alone.
# HTTP_PORT=18080

# -----------------------------------------------------------------------------
# Build-time base path
# -----------------------------------------------------------------------------
# Empty = served from the domain root, which is what a local run wants.
#
# Set it ONLY if you are hosting the export under a sub-path, e.g.
# NEXT_PUBLIC_BASE_PATH=/omnistack. Next.js inlines this into the client
# bundle at build time, so changing it here without `--build` has no effect.
#
# There is deliberately no envsubst/runtime templating: nginx here is a pure
# static server, and rewriting paths at request time would mean giving up the
# read-only filesystem for no benefit.
NEXT_PUBLIC_BASE_PATH=
